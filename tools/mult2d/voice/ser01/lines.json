[
 {
  "id": "ser01_001",
  "who": "kot",
  "src": "intro_019",
  "text": "…а Кощей, как водится, — проиграл. Тут и сказке конец!",
  "dur": 4.71,
  "take": "ser01_001_t1.wav"
 },
 {
  "id": "ser01_002",
  "who": "koschei",
  "src": "intro_020",
  "text": "Как водится… проиграл.",
  "how": "тихо",
  "dur": 2.56,
  "take": "ser01_002_t1.wav",
  "instruct": "very quiet, tired and cold, almost a sigh"
 },
 {
  "id": "ser01_003",
  "who": "kot",
  "src": "intro_021",
  "text": "А теперь — колыбельная…",
  "dur": 1.82,
  "take": "ser01_003_t2.wav"
 },
 {
  "id": "ser01_004",
  "who": "kot",
  "src": "intro_022",
  "text": "Баю-баю, за рекою, серый волк живёт…",
  "how": "поёт",
  "dur": 3.02,
  "take": "ser01_004_t2.wav",
  "instruct": "singing a gentle slow lullaby"
 },
 {
  "id": "ser01_005",
  "who": "koschei",
  "src": "intro_023",
  "text": "Довольно.",
  "dur": 0.78,
  "take": "ser01_005_t1.wav"
 },
 {
  "id": "ser01_006",
  "who": "kolobok",
  "src": "intro_024",
  "text": "Я от бабушки ушёл — а от тучи — укачусь!",
  "how": "нараспев",
  "dur": 2.95,
  "take": "ser01_006_t2.wav",
  "instruct": "singing cheerfully and fast, bouncy"
 },
 {
  "id": "ser01_007",
  "who": "kot",
  "src": "intro_025",
  "text": "Кто там?! Тебя сюда не звали!",
  "dur": 2.57,
  "take": "ser01_007_t1.wav",
  "instruct": "alarmed and loud, bristling"
 },
 {
  "id": "ser01_008",
  "who": "kot",
  "src": "intro_026",
  "text": "Разлетелись звенья по свету —",
  "dur": 1.98,
  "take": "ser01_008_t2.wav"
 },
 {
  "id": "ser01_009",
  "who": "kot",
  "src": "intro_027",
  "text": "В лес дремучий…",
  "dur": 1.26,
  "take": "ser01_009_t2.wav"
 },
 {
  "id": "ser01_010",
  "who": "kot",
  "src": "intro_028",
  "text": "…в Китеж подводный…",
  "dur": 1.21,
  "take": "ser01_010_t2.wav"
 },
 {
  "id": "ser01_011",
  "who": "kot",
  "src": "intro_029",
  "text": "…за облака…",
  "dur": 0.74,
  "take": "ser01_011_t1.wav"
 },
 {
  "id": "ser01_012",
  "who": "kot",
  "src": "intro_030",
  "text": "…за огненную реку…",
  "dur": 1.37,
  "take": "ser01_012_t1.wav"
 },
 {
  "id": "ser01_013",
  "who": "kot",
  "src": "intro_031",
  "text": "…на остров Буян.",
  "dur": 1.22,
  "take": "ser01_013_t1.wav"
 },
 {
  "id": "ser01_014",
  "who": "kot",
  "src": "intro_032",
  "text": "Без цепи сказки забываются — слово за словом рассыпаются.",
  "dur": 4.42,
  "take": "ser01_014_t2.wav"
 },
 {
  "id": "ser01_015",
  "who": "kot",
  "src": "intro_008",
  "text": "А в дремучем лесу, на сосне, светит штаб огоньком в окне.",
  "dur": 4.39,
  "take": "ser01_015_t1.wav"
 },
 {
  "id": "ser01_016",
  "who": "kot",
  "src": "intro_009",
  "text": "Четверо друзей там живут — Лесным патрулём их зовут.",
  "dur": 3.6,
  "take": "ser01_016_t2.wav"
 },
 {
  "id": "ser01_017",
  "who": "proshka",
  "src": "intro_010",
  "text": "Сказки — сказками, а техника — вещь!",
  "dur": 1.74,
  "take": "ser01_017_t1.wav"
 },
 {
  "id": "ser01_018",
  "who": "potap",
  "src": "intro_011",
  "text": "Держу-держу. Хо-хо!",
  "dur": 1.38,
  "take": "ser01_018_t2.wav"
 },
 {
  "id": "ser01_019",
  "who": "yosha",
  "src": "intro_012",
  "text": "Сам вырастил! Я сам!",
  "dur": 2.1,
  "take": "ser01_019_t1.wav"
 },
 {
  "id": "ser01_020",
  "who": "pelageya",
  "src": "intro_013",
  "text": "В некотором царстве… нет, не так…",
  "how": "шёпотом",
  "instruct": "shy breathy whisper",
  "dur": 5.25,
  "take": "ser01_020_t2.wav"
 },
 {
  "id": "ser01_021",
  "who": "tishka",
  "src": "intro_014",
  "text": "Сказку! Кто мне сказку на ночь?",
  "dur": 2.6,
  "take": "ser01_021_t1.wav"
 },
 {
  "id": "ser01_022",
  "who": "proshka",
  "src": "intro_015",
  "text": "Чур, я!",
  "dur": 0.74,
  "take": "ser01_022_t2.wav"
 },
 {
  "id": "ser01_023",
  "who": "potap",
  "src": "intro_016",
  "text": "Я!",
  "dur": 0.55,
  "take": "ser01_023_t1.wav"
 },
 {
  "id": "ser01_024",
  "who": "yosha",
  "src": "intro_017",
  "text": "Нет, я сам!",
  "dur": 1.0,
  "take": "ser01_024_t2.wav"
 },
 {
  "id": "ser01_025",
  "who": "pelageya",
  "src": "intro_018",
  "text": "…и я.",
  "how": "шёпотом",
  "instruct": "shy breathy whisper",
  "dur": 0.78,
  "take": "ser01_025_t2.wav"
 },
 {
  "id": "ser01_026",
  "who": "pelageya",
  "src": "intro_033",
  "text": "Ой… летит… к нам!",
  "how": "шёпотом",
  "instruct": "breathy frightened whisper",
  "dur": 3.21,
  "take": "ser01_026_t1.wav"
 },
 {
  "id": "ser01_027",
  "who": "tishka",
  "src": "p01_bayu",
  "text": "Баю-баю, за рекою…",
  "how": "поёт",
  "instruct": "singing softly and sleepily",
  "dur": 2.0,
  "take": "ser01_027_t2.wav"
 },
 {
  "id": "ser01_028",
  "who": "tishka",
  "src": "p02_zabyl",
  "text": "Дальше слов не помню я…",
  "instruct": "sad and sleepy",
  "dur": 1.92,
  "take": "ser01_028_t1.wav"
 },
 {
  "id": "ser01_029",
  "who": "proshka",
  "src": "p03_malyshi",
  "text": "Колыбельные — для малых, не для нас, для удалых!",
  "dur": 2.37,
  "take": "ser01_029_t1.wav"
 },
 {
  "id": "ser01_030",
  "who": "proshka",
  "src": "p04_samokat",
  "text": "Хочешь — дам самокат, дружок? Он получше всяких строк!",
  "dur": 3.23,
  "take": "ser01_030_t1.wav"
 },
 {
  "id": "ser01_031",
  "who": "yosha",
  "src": "p05_haha",
  "text": "Ха-ха-ха! Вот так дела!",
  "instruct": "laughing merrily",
  "dur": 1.75,
  "take": "ser01_031_t2.wav"
 },
 {
  "id": "ser01_032",
  "who": "potap",
  "src": "p05b_hoho",
  "text": "Хо-хо-хо!",
  "instruct": "laughing heartily",
  "dur": 1.4,
  "take": "ser01_032_t1.wav"
 },
 {
  "id": "ser01_033",
  "who": "tishka",
  "src": "p05a_hihi",
  "text": "Хи-хи-хи!",
  "instruct": "giggling",
  "dur": 0.86,
  "take": "ser01_033_t1.wav"
 },
 {
  "id": "ser01_034",
  "who": "proshka",
  "src": "p05d_prokatilsya",
  "text": "Ха-ха! Вот это я прокатился!",
  "instruct": "laughing",
  "dur": 2.13,
  "take": "ser01_034_t3.wav"
 },
 {
  "id": "ser01_035",
  "who": "zven",
  "src": "p06_bezhim",
  "text": "Дзинь-дзинь! За мной — бегом!",
  "dur": 2.27,
  "take": "ser01_035_t1.wav"
 },
 {
  "id": "ser01_036",
  "who": "kot",
  "src": "intro_034",
  "text": "Кто соберёт звено к звену?",
  "dur": 1.85,
  "take": "ser01_036_t1.wav"
 },
 {
  "id": "ser01_037",
  "who": "kot",
  "src": "intro_035",
  "text": "Кто сказку вспомнит — не одну?",
  "dur": 1.96,
  "take": "ser01_037_t3.wav"
 },
 {
  "id": "ser01_038",
  "who": "kot",
  "src": "intro_036",
  "text": "Это присказка, не сказка. Сказка — будет впереди!",
  "dur": 4.68,
  "take": "ser01_038_t2.wav"
 },
 {
  "id": "ser01_039",
  "who": "koschei",
  "src": "luko_082",
  "text": "Сказок больше не бывать.",
  "instruct": "quiet, cold and sad",
  "dur": 1.77,
  "take": "ser01_039_t1.wav"
 },
 {
  "id": "ser01_040",
  "who": "kot",
  "src": "новая",
  "text": "Стоп-стоп-стоп! Это из середины. Начнём по порядку…",
  "instruct": "playful, hurried, like a storyteller who got ahead of himself",
  "dur": 3.29,
  "take": "ser01_040_t1.wav"
 },
 {
  "id": "ser01_041",
  "who": "kot",
  "src": "новая",
  "text": "Не отдам!",
  "instruct": "straining with effort, through gritted teeth",
  "dur": 0.92,
  "take": "ser01_041_t1.wav"
 },
 {
  "id": "ser01_042",
  "who": "pelageya",
  "src": "новая",
  "text": "Летит!",
  "instruct": "trying to shout but only a thin squeak comes out",
  "dur": 0.53,
  "take": "ser01_042_t3.wav"
 },
 {
  "id": "ser01_043",
  "who": "zven",
  "src": "новая",
  "text": "Спрячьте! Спрячьте меня!",
  "instruct": "panicked, fast, out of breath",
  "dur": 1.8,
  "take": "ser01_043_t2.wav"
 },
 {
  "id": "ser01_044",
  "who": "potap",
  "src": "новая",
  "text": "Пелагея… ты ведь первая увидела?",
  "instruct": "slow, warm, surprised",
  "dur": 2.16,
  "take": "ser01_044_t2.wav"
 },
 {
  "id": "ser01_045",
  "who": "yosha",
  "src": "новая",
  "text": "Ведёшь — ты!",
  "instruct": "excited, proud",
  "dur": 1.23,
  "take": "ser01_045_t1.wav"
 },
 {
  "id": "ser01_101",
  "who": "proshka",
  "text": "Тревога! Патруль — на выход!",
  "instruct": "shouting commands into a megaphone, excited",
  "dur": 2.5,
  "take": "ser01_101_t.wav"
 },
 {
  "id": "ser01_102",
  "who": "proshka",
  "text": "Хэк! Щас рекорд будет!",
  "instruct": "cheeky and excited, in a hurry",
  "dur": 1.83,
  "take": "ser01_102_t.wav"
 },
 {
  "id": "ser01_103",
  "who": "potap",
  "text": "Всех донесу! Разом!",
  "instruct": "booming, straining with effort",
  "dur": 1.42,
  "take": "ser01_103_t.wav"
 },
 {
  "id": "ser01_104",
  "who": "yosha",
  "text": "Без помощи! Смотрите!",
  "instruct": "proud and stubborn, shouting happily",
  "dur": 2.14,
  "take": "ser01_104_t.wav"
 },
 {
  "id": "ser01_105",
  "who": "pelageya",
  "text": "Я тут… уже давно.",
  "how": "тихо",
  "instruct": "quiet and calm, without resentment",
  "dur": 2.79,
  "take": "ser01_105_t.wav"
 },
 {
  "id": "ser01_106",
  "who": "proshka",
  "text": "Две минуты сорок! Позор, патруль!",
  "instruct": "indignant, like a strict coach",
  "dur": 2.78,
  "take": "ser01_106_t.wav"
 },
 {
  "id": "ser01_107",
  "who": "pelageya",
  "text": "Журнал патруля. Запись сорок вторая. Учебная тревога.",
  "how": "за кадром",
  "instruct": "clear, intimate narration close to the microphone, calm",
  "dur": 5.8,
  "take": "ser01_107_t.wav"
 },
 {
  "id": "ser01_108",
  "who": "pelageya",
  "text": "Кто пришёл первым — опять никто не заметил.",
  "how": "за кадром",
  "instruct": "clear intimate narration with a soft smile",
  "dur": 4.77,
  "take": "ser01_108_t.wav"
 },
 {
  "id": "ser01_109",
  "who": "proshka",
  "text": "Пелагея — дежурная. Ты всё равно тихо сидишь.",
  "instruct": "yawning, sleepy and careless",
  "dur": 3.32,
  "take": "ser01_109_t.wav"
 },
 {
  "id": "ser01_110",
  "who": "pelageya",
  "text": "Запись сорок третья. Над морем что-то порвалось. Я это слышала.",
  "how": "за кадром",
  "instruct": "clear intimate narration, worried",
  "dur": 5.25,
  "take": "ser01_110_t.wav"
 },
 {
  "id": "ser01_111",
  "who": "pelageya",
  "text": "Ребята… над морем вспыхнуло.",
  "how": "тихо",
  "instruct": "quiet and shy",
  "dur": 3.29,
  "take": "ser01_111_t.wav"
 },
 {
  "id": "ser01_112",
  "who": "proshka",
  "text": "Дежурная докладывает громко и чётко!",
  "instruct": "bossy, commanding",
  "dur": 2.27,
  "take": "ser01_112_t.wav"
 },
 {
  "id": "ser01_113",
  "who": "pelageya",
  "text": "Ух!",
  "instruct": "a sudden loud owl hoot",
  "dur": 0.55,
  "take": "ser01_113_t.wav"
 },
 {
  "id": "ser01_114",
  "who": "yosha",
  "text": "Ух! Совиная тревога!",
  "instruct": "laughing",
  "dur": 1.65,
  "take": "ser01_114_t.wav"
 },
 {
  "id": "ser01_115",
  "who": "pelageya",
  "text": "Кто-то летит. Много.",
  "how": "шёпотом",
  "instruct": "whispering, alarmed",
  "dur": 2.01,
  "take": "ser01_115_t.wav"
 },
 {
  "id": "ser01_116",
  "who": "potap",
  "text": "Это у меня в животе летит. Есть хочу.",
  "instruct": "good-natured, mouth full of honey",
  "dur": 2.1,
  "take": "ser01_116_t.wav"
 },
 {
  "id": "ser01_117",
  "who": "zven",
  "text": "Помоги-и-ите…",
  "how": "издалека",
  "instruct": "thin and far away, crying for help",
  "dur": 1.42,
  "take": "ser01_117_t.wav"
 },
 {
  "id": "ser01_118",
  "who": "pelageya",
  "text": "Там кто-то плачет.",
  "how": "тихо",
  "instruct": "quiet, worried",
  "dur": 1.11,
  "take": "ser01_118_t.wav"
 },
 {
  "id": "ser01_119",
  "who": "yosha",
  "text": "Это Тишка храпит.",
  "instruct": "dismissive, careless",
  "dur": 1.53,
  "take": "ser01_119_t.wav"
 },
 {
  "id": "ser01_120",
  "who": "pelageya",
  "text": "Запись сорок четвёртая. Значит, сама.",
  "how": "за кадром",
  "instruct": "clear intimate narration, decisive",
  "dur": 3.06,
  "take": "ser01_120_t.wav"
 },
 {
  "id": "ser01_121",
  "who": "zven",
  "text": "Дзинь! Цепь… дуб… Ко… Ко…",
  "instruct": "out of breath, panicking, broken words",
  "dur": 2.37,
  "take": "ser01_121_t.wav"
 },
 {
  "id": "ser01_122",
  "who": "potap",
  "text": "Ко-ко? Курица, что ли?",
  "instruct": "puzzled, slow",
  "dur": 2.21,
  "take": "ser01_122_t.wav"
 },
 {
  "id": "ser01_123",
  "who": "zven",
  "text": "Ко-щей! Порвал! Всё по-рва-лось!",
  "instruct": "panicking, syllable by syllable",
  "dur": 2.56,
  "take": "ser01_123_t.wav"
 },
 {
  "id": "ser01_124",
  "who": "proshka",
  "text": "Говорящая гайка. Научно невозможно.",
  "instruct": "pompous, like a scientist",
  "dur": 2.92,
  "take": "ser01_124_t.wav"
 },
 {
  "id": "ser01_125",
  "who": "zven",
  "text": "Сам ты гайка!",
  "instruct": "offended, squeaky",
  "dur": 1.31,
  "take": "ser01_125_t.wav"
 },
 {
  "id": "ser01_126",
  "who": "yosha",
  "text": "Чур, я держу! Я аккуратно!",
  "instruct": "eager",
  "dur": 2.42,
  "take": "ser01_126_t.wav"
 },
 {
  "id": "ser01_127",
  "who": "tishka",
  "text": "Блестяшка… моя…",
  "how": "сквозь сон",
  "instruct": "mumbling in sleep",
  "dur": 2.94,
  "take": "ser01_127_t.wav"
 },
 {
  "id": "ser01_128",
  "who": "pelageya",
  "text": "Не кричи. Покажи.",
  "how": "мягко",
  "instruct": "soft and gentle",
  "dur": 1.8,
  "take": "ser01_128_t.wav"
 },
 {
  "id": "ser01_129",
  "who": "zven",
  "text": "Кот сказки сказывал — цепь звенела. Пришла тень — цепь не стерпела.",
  "instruct": "rhythmic counting-rhyme, storytelling",
  "dur": 5.09,
  "take": "ser01_129_t.wav"
 },
 {
  "id": "ser01_130",
  "who": "zven",
  "text": "Звенья — врассыпную… А Кот замолчал. Камнем стал.",
  "how": "тихо",
  "instruct": "quiet and sad",
  "dur": 4.29,
  "take": "ser01_130_t.wav"
 },
 {
  "id": "ser01_131",
  "who": "proshka",
  "text": "Хэк! Длинный, как жердь! Кощей-жердей!",
  "instruct": "teasing, laughing",
  "dur": 3.3,
  "take": "ser01_131_t.wav"
 },
 {
  "id": "ser01_132",
  "who": "proshka",
  "text": "Тре…",
  "instruct": "cut off abruptly",
  "dur": 0.73,
  "take": "ser01_132_t.wav"
 },
 {
  "id": "ser01_133",
  "who": "pelageya",
  "text": "Тсс.",
  "instruct": "a firm quiet shush",
  "dur": 0.42,
  "take": "ser01_133_t.wav"
 },
 {
  "id": "ser01_134",
  "who": "pelageya",
  "text": "Спи, бельчонок, тише-тише… Сказку ветер не услышит.",
  "how": "напевая шёпотом",
  "instruct": "softly singing a whispered lullaby",
  "dur": 5.46,
  "take": "ser01_134_t.wav"
 },
 {
  "id": "ser01_135",
  "who": "proshka",
  "text": "…Сорок секунд. Рекорд.",
  "how": "шёпотом",
  "instruct": "whispering, amazed",
  "dur": 2.55,
  "take": "ser01_135_t.wav"
 },
 {
  "id": "ser01_136",
